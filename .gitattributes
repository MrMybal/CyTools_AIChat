# Text is stored with LF, as in the CyToolsCore repository. Only the Windows batch file
# keeps CRLF, which cmd.exe expects.
*           text=auto eol=lf
*.cmd       text eol=crlf
*.png       binary
*.exe       binary
*.dll       binary
*.whl       binary
*.gguf      binary
*.ico binary
.github export-ignore

# Distribute the complete generated manual, never its private build workspace.
app/.CyDocBuild export-ignore
app/.CyDocExport export-ignore
app/.CyDocExport.previous export-ignore
